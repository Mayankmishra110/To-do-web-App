{
  "name": "plugbase-vscode",
  "displayName": "Plugbase",
  "description": "Run Plugbase project tools from VS Code and Cursor.",
  "version": "0.1.0",
  "publisher": "mayankmishra110",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/mayankmishra110/plugbase" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["workspaceContains:plugbase.config.json"],
  "contributes": {
    "commands": [
      { "command": "plugbase.runTool", "title": "Run Tool…", "category": "Plugbase" },
      { "command": "plugbase.init", "title": "Create Config", "category": "Plugbase" },
      { "command": "plugbase.clear", "title": "Clear Results", "category": "Plugbase" }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.js",
    "package": "vsce package --no-dependencies --out plugbase.vsix"
  },
  "devDependencies": {
    "plugbase": "0.1.0",
    "@types/vscode": "~1.85.0",
    "@types/node": "^20.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
