# Copy to .env and fill in.

# Any Postgres connection string. A free Neon/Supabase/Prisma Postgres
# database is enough for one person's data for years.
DATABASE_URL="postgresql://user:password@host:5432/astrotracker?schema=public"

# Secret used to sign the session cookie. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-me"

# Only read by `npm run seed`, to create the single account on first setup.
SEED_EMAIL="you@example.com"
SEED_PASSWORD="choose-a-strong-password"
SEED_NAME="Your name"
SEED_TIMEZONE="Asia/Kolkata"
